generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid(7))
  phone        String?        @unique
  email        String?        @unique
  passwordHash String?
  roles        String[]       @default(["USER"])
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  devices       Device[]
  products      Product[]
  skus          Sku[]
  media         Media[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id         String   @id @default(uuid(7))
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model OtpRequest {
  id        String   @id @default(uuid(7))
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_requests")
}

model Device {
  id          String   @id @default(uuid(7))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  deviceType  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("devices")
}

model Category {
  id        String    @id @default(uuid(7))
  name      String
  slug      String    @unique
  parentId  String?
  parent    Category? @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  path      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid(7))
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Product {
  id          String                  @id @default(uuid(7))
  name        String
  slug        String                  @unique
  description String?
  status      String                  @default("DRAFT")
  categoryId  String?
  category    Category?               @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?                  @relation(fields: [brandId], references: [id])
  sellerId    String
  seller      User                    @relation(fields: [sellerId], references: [id])
  sizeChartId String?
  sizeChart   SizeChart?              @relation(fields: [sizeChartId], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  variants    ProductVariant[]
  attributes  ProductAttributeValueMap[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([sellerId])
  @@index([sizeChartId])
  @@map("products")
}

model ProductVariant {
  id        String         @id @default(uuid(7))
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  skus      Sku[]
  images    ProductImage[]

  @@index([productId])
  @@map("product_variants")
}

model Sku {
  id        String         @id @default(uuid(7))
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  skuCode   String
  sellerId  String
  seller    User           @relation(fields: [sellerId], references: [id])
  size      String
  price     BigInt
  mrp       BigInt
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([sellerId, skuCode])
  @@index([variantId])
  @@map("skus")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

model Media {
  id            String        @id @default(uuid(7))
  filename      String
  contentType   String
  storageKey    String        @unique
  status        MediaStatus   @default(PENDING_UPLOAD)
  processedUrls Json?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productImage  ProductImage?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@map("media")
}

model ProductImage {
  id        String         @id @default(uuid(7))
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  mediaId   String?        @unique
  media     Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([variantId])
  @@map("product_images")
}

model Attribute {
  id        String           @id @default(uuid(7))
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String                   @id @default(uuid(7))
  attributeId String
  attribute   Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  products    ProductAttributeValueMap[]

  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttributeValueMap {
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_attribute_map")
}

model SizeChart {
  id        String    @id @default(uuid(7))
  name      String
  chartData Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("size_charts")
}

model OutboxEvent {
  id          String    @id @default(uuid(7))
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processed])
  @@map("outbox_events")
}
