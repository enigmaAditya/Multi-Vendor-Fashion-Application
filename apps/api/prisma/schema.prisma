generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid(7))
  phone        String?        @unique
  email        String?        @unique
  passwordHash String?
  roles        String[]       @default(["USER"])
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  devices       Device[]
  products      Product[]
  skus          Sku[]
  media         Media[]
  orders        Order[]
  subOrders     SubOrder[]
  payouts       Payout[]
  reviews       Review[]
  sellerCoupons Coupon[]        @relation("SellerCoupons")
  couponRedemptions CouponRedemption[]
  linkedAccount SellerLinkedAccount?
  notificationLogs NotificationLog[]
  notificationPreference UserNotificationPreference?
  deviceTokens UserDeviceToken[]
  productViews UserProductView[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id         String   @id @default(uuid(7))
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model OtpRequest {
  id        String   @id @default(uuid(7))
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_requests")
}

model Device {
  id          String   @id @default(uuid(7))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  deviceType  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("devices")
}

model Category {
  id        String    @id @default(uuid(7))
  name      String
  slug      String    @unique
  parentId  String?
  parent    Category? @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  path      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  coupons   Coupon[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid(7))
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

enum ProductStatus {
  PENDING_UPLOAD
  PENDING_REVIEW
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LIVE
  ARCHIVED
  SUSPENDED
}

enum SubOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
  COMPLETED
}

enum SubOrderSettlementStatus {
  PENDING
  SETTLING
  SETTLED
  BLOCKED
  CANCELED
  FAILED_PERMANENT
  CLAWBACK_REQUIRED
}

enum SubOrderShipmentStatus {
  PENDING_SYNC
  SYNCING
  SYNCED
  FAILED_SYNC
  IN_TRANSIT
  DELIVERED
  RTO
  CANCELLED
  LOST
}

enum CouponFundingType {
  PLATFORM
  SELLER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Product {
  id          String                  @id @default(uuid(7))
  name        String
  slug        String                  @unique
  description String?
  status      ProductStatus           @default(DRAFT)
  categoryId  String?
  category    Category?               @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?                  @relation(fields: [brandId], references: [id])
  sellerId    String
  seller      User                    @relation(fields: [sellerId], references: [id])
  sizeChartId String?
  sizeChart   SizeChart?              @relation(fields: [sizeChartId], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  variants    ProductVariant[]
  attributes  ProductAttributeValueMap[]
  reviews     Review[]
  views       UserProductView[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([sellerId])
  @@index([sizeChartId])
  @@map("products")
}

model ProductVariant {
  id        String         @id @default(uuid(7))
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  skus      Sku[]
  images    ProductImage[]

  @@index([productId])
  @@map("product_variants")
}

model Sku {
  id        String         @id @default(uuid(7))
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  skuCode   String
  sellerId  String
  seller    User           @relation(fields: [sellerId], references: [id])
  size      String
  price     BigInt
  mrp       BigInt
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  inventories  SkuInventory[]
  reservations InventoryReservation[]
  ledgers      InventoryLedger[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@unique([sellerId, skuCode])
  @@index([variantId])
  @@map("skus")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

model Media {
  id            String        @id @default(uuid(7))
  filename      String
  contentType   String
  storageKey    String        @unique
  status        MediaStatus   @default(PENDING_UPLOAD)
  processedUrls Json?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productImage  ProductImage?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@map("media")
}

model ProductImage {
  id        String         @id @default(uuid(7))
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  mediaId   String?        @unique
  media     Media?         @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([variantId])
  @@map("product_images")
}

model Attribute {
  id        String           @id @default(uuid(7))
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String                   @id @default(uuid(7))
  attributeId String
  attribute   Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  products    ProductAttributeValueMap[]

  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttributeValueMap {
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_attribute_map")
}

model SizeChart {
  id        String    @id @default(uuid(7))
  name      String
  chartData Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("size_charts")
}

model OutboxEvent {
  id          String    @id @default(uuid(7))
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processed])
  @@map("outbox_events")
}

model Warehouse {
  id           String                 @id @default(uuid(7))
  name         String                 @unique
  code         String                 @unique
  address      String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inventories  SkuInventory[]
  reservations InventoryReservation[]
  ledgers      InventoryLedger[]

  @@map("warehouses")
}

model SkuInventory {
  id          String    @id @default(uuid(7))
  skuId       String
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, skuId])
  @@map("sku_inventories")
}

model InventoryReservation {
  id              String    @id @default(uuid(7))
  skuId           String
  sku             Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  userId          String
  orderId         String?
  reservationCode String
  quantity        Int
  expiresAt       DateTime
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([reservationCode, skuId])
  @@index([expiresAt])
  @@index([status])
  @@map("inventory_reservations")
}

model InventoryLedger {
  id            String    @id @default(uuid(7))
  skuId         String
  sku           Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantityDelta Int       @default(0)
  reservedDelta Int       @default(0)
  type          String
  referenceId   String?
  reason        String?
  createdAt     DateTime  @default(now())

  @@index([skuId])
  @@index([referenceId])
  @@map("inventory_ledger")
}

model Order {
  id               String      @id @default(uuid(7))
  buyerId          String
  buyer            User        @relation(fields: [buyerId], references: [id])
  totalAmount      BigInt
  discountAmount   BigInt      @default(0) @map("discount_amount")
  amountCharged    BigInt      @default(0) @map("amount_charged")
  paymentStatus    String      @default("PENDING")
  gatewayOrderId   String      @unique
  gatewayPaymentId String?
  reservationCode  String?
  shippingAddress  Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  subOrders        SubOrder[]
  reviews          Review[]
  couponRedemption CouponRedemption?
  promotionLedger  PromotionLedger[]

  @@map("orders")
}

model SubOrder {
  id               String                   @id @default(uuid(7))
  orderId          String
  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User                     @relation(fields: [sellerId], references: [id])
  amount           BigInt
  status           SubOrderStatus           @default(PENDING)
  deliveredAt      DateTime?
  settlementStatus SubOrderSettlementStatus @default(PENDING)
  shipmentId       String?                  @unique
  awbCode          String?                  @unique
  courierName      String?
  shipmentStatus   SubOrderShipmentStatus   @default(PENDING_SYNC)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  items            OrderItem[]
  payout           Payout?
  commissionLogs   CommissionLedger[]

  @@index([sellerId, status])
  @@map("sub_orders")
}

model OrderItem {
  id         String   @id @default(uuid(7))
  subOrderId String
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  skuId      String
  sku        Sku      @relation(fields: [skuId], references: [id])
  quantity   Int
  price      BigInt
  mrp        BigInt

  @@map("order_items")
}

model PaymentWebhookLog {
  eventId   String   @id
  processed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("payment_webhook_logs")
}

model CommissionRule {
  id              String   @id @default(uuid(7))
  categoryId      String?  @unique
  sellerId        String?  @unique
  rateBasisPoints Int      // e.g. 500 = 5.00%, 1000 = 10.00%
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("commission_rules")
}

model CommissionLedger {
  id                  String   @id @default(uuid(7))
  subOrderId          String
  amount              BigInt   // Commission amount in paise
  feeRateBasisPoints  Int      // Basis points rate applied at settlement (e.g. 500 = 5.00%)
  type                String   // "EARNED", "REFUNDED"
  createdAt           DateTime @default(now())

  subOrder      SubOrder @relation(fields: [subOrderId], references: [id])

  @@map("commission_ledger")
}

model SellerLinkedAccount {
  id                String   @id @default(uuid(7))
  sellerId          String   @unique
  gatewayAccountId  String   // Razorpay Route account ID (acc_xxx)
  status            String   // "ACTIVE", "SUSPENDED"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [sellerId], references: [id])

  @@map("seller_linked_accounts")
}

model Payout {
  id                String    @id @default(uuid(7))
  sellerId          String
  subOrderId        String    @unique
  amount            BigInt    // Net payout to seller
  gatewayTransferId String?   // Razorpay transfer transaction ID
  status            String    // "PENDING", "SUCCESS", "FAILED", "BLOCKED", "FAILED_PERMANENT"
  idempotencyKey    String    @unique
  retryCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subOrder          SubOrder  @relation(fields: [subOrderId], references: [id])
  seller            User      @relation(fields: [sellerId], references: [id])

  @@map("payouts")
}

model ShipmentWebhookLog {
  id        String   @id @default(uuid(7))
  awbCode   String
  status    String
  createdAt DateTime @default(now())

  @@unique([awbCode, status])
  @@map("shipment_webhook_logs")
}

model SearchQueryLog {
  id           String   @id @default(uuid(7))
  query        String
  filters      String?  // JSON stringified filters
  resultsCount Int
  userId       String?
  createdAt    DateTime @default(now())

  @@map("search_queries_log")
}

model Review {
  id        String   @id @default(uuid(7))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  rating    Int      // 1 to 5 stars
  title     String?
  comment   String?
  status    String   @default("APPROVED") // APPROVED, REJECTED, FLAGGED
  skuId     String?
  sku       Sku?     @relation(fields: [skuId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, buyerId])
  @@index([productId])
  @@index([buyerId])
  @@map("reviews")
}

model Coupon {
  id                    String             @id @default(uuid(7))
  code                  String             @unique
  description           String?
  discountType          DiscountType       @map("discount_type") // PERCENTAGE or FIXED
  discountValue         BigInt             @map("discount_value") // Percentage (e.g. 15 for 15%) or Fixed amount in paise (e.g. 5000 for ₹50)
  fundingType           CouponFundingType  @default(PLATFORM) @map("funding_type") // PLATFORM or SELLER
  maxDiscountAmount     BigInt?            @map("max_discount_amount") // Max cap in paise for PERCENTAGE coupons
  minOrderAmount        BigInt             @default(0) @map("min_order_amount") // Min qualifying cart subtotal in paise
  maxRedemptions        Int?               @map("max_redemptions") // Global redemption cap (null = unlimited)
  currentRedemptions    Int                @default(0) @map("current_redemptions") // Atomic counter
  maxRedemptionsPerUser Int                @default(1) @map("max_redemptions_per_user") // Max redemptions per customer
  sellerId              String?            @map("seller_id") // Optional: Seller-funded coupon
  seller                User?              @relation("SellerCoupons", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId            String?            @map("category_id") // Optional: Category-scoped coupon
  category              Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startsAt              DateTime           @default(now()) @map("starts_at")
  expiresAt             DateTime           @map("expires_at")
  isActive              Boolean            @default(true) @map("is_active")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  redemptions           CouponRedemption[]

  @@index([code])
  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid(7))
  couponId       String   @map("coupon_id")
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String   @unique @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount BigInt   @map("discount_amount") // Actual discount applied in paise
  status         String   @default("CONFIRMED") // RESERVED, CONFIRMED, EXPIRED
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model PromotionLedger {
  id        String   @id @default(uuid(7))
  orderId   String   @map("order_id")
  couponId  String   @map("coupon_id")
  amount    BigInt   // Promotional discount funded by platform in paise
  type      String   @default("PLATFORM_PROMO_EXPENSE")
  createdAt DateTime @default(now()) @map("created_at")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("promotion_ledger")
}

model NotificationLog {
  id             String   @id @default(uuid(7))
  outboxEventId  String   @map("outbox_event_id")
  channel        String   // "PUSH", "EMAIL", "SMS"
  recipientId    String   @map("recipient_id")
  recipient      User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status         String   @default("PENDING") // "PENDING", "SENT", "FAILED"
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([outboxEventId, channel, recipientId])
  @@index([recipientId])
  @@map("notification_logs")
}

model UserNotificationPreference {
  id                 String   @id @default(uuid(7))
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled       Boolean  @default(true) @map("email_enabled")
  pushEnabled        Boolean  @default(true) @map("push_enabled")
  promotionalEnabled Boolean  @default(true) @map("promotional_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_notification_preferences")
}

model UserDeviceToken {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "WEB", "ANDROID", "IOS"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_device_tokens")
}

model UserProductView {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("user_product_views")
}


