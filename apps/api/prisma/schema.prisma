generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid(7))
  phone        String?        @unique
  email        String?        @unique
  passwordHash String?
  roles        String[]       @default(["USER"])
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  devices       Device[]
  products      Product[]
  skus          Sku[]
  media         Media[]
  orders        Order[]
  subOrders     SubOrder[]
  payouts       Payout[]
  linkedAccount SellerLinkedAccount?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id         String   @id @default(uuid(7))
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model OtpRequest {
  id        String   @id @default(uuid(7))
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_requests")
}

model Device {
  id          String   @id @default(uuid(7))
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  deviceType  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("devices")
}

model Category {
  id        String    @id @default(uuid(7))
  name      String
  slug      String    @unique
  parentId  String?
  parent    Category? @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  path      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid(7))
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Product {
  id          String                  @id @default(uuid(7))
  name        String
  slug        String                  @unique
  description String?
  status      String                  @default("DRAFT")
  categoryId  String?
  category    Category?               @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?                  @relation(fields: [brandId], references: [id])
  sellerId    String
  seller      User                    @relation(fields: [sellerId], references: [id])
  sizeChartId String?
  sizeChart   SizeChart?              @relation(fields: [sizeChartId], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  variants    ProductVariant[]
  attributes  ProductAttributeValueMap[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([sellerId])
  @@index([sizeChartId])
  @@map("products")
}

model ProductVariant {
  id        String         @id @default(uuid(7))
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  skus      Sku[]
  images    ProductImage[]

  @@index([productId])
  @@map("product_variants")
}

model Sku {
  id        String         @id @default(uuid(7))
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  skuCode   String
  sellerId  String
  seller    User           @relation(fields: [sellerId], references: [id])
  size      String
  price     BigInt
  mrp       BigInt
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  inventories  SkuInventory[]
  reservations InventoryReservation[]
  ledgers      InventoryLedger[]
  orderItems   OrderItem[]

  @@unique([sellerId, skuCode])
  @@index([variantId])
  @@map("skus")
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

model Media {
  id            String        @id @default(uuid(7))
  filename      String
  contentType   String
  storageKey    String        @unique
  status        MediaStatus   @default(PENDING_UPLOAD)
  processedUrls Json?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productImage  ProductImage?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@map("media")
}

model ProductImage {
  id        String         @id @default(uuid(7))
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  mediaId   String?        @unique
  media     Media?         @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([variantId])
  @@map("product_images")
}

model Attribute {
  id        String           @id @default(uuid(7))
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String                   @id @default(uuid(7))
  attributeId String
  attribute   Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  products    ProductAttributeValueMap[]

  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttributeValueMap {
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_attribute_map")
}

model SizeChart {
  id        String    @id @default(uuid(7))
  name      String
  chartData Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("size_charts")
}

model OutboxEvent {
  id          String    @id @default(uuid(7))
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processed])
  @@map("outbox_events")
}

model Warehouse {
  id           String                 @id @default(uuid(7))
  name         String                 @unique
  code         String                 @unique
  address      String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inventories  SkuInventory[]
  reservations InventoryReservation[]
  ledgers      InventoryLedger[]

  @@map("warehouses")
}

model SkuInventory {
  id          String    @id @default(uuid(7))
  skuId       String
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, skuId])
  @@map("sku_inventories")
}

model InventoryReservation {
  id              String    @id @default(uuid(7))
  skuId           String
  sku             Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  userId          String
  orderId         String?
  reservationCode String
  quantity        Int
  expiresAt       DateTime
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([reservationCode, skuId])
  @@index([expiresAt])
  @@index([status])
  @@map("inventory_reservations")
}

model InventoryLedger {
  id            String    @id @default(uuid(7))
  skuId         String
  sku           Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantityDelta Int       @default(0)
  reservedDelta Int       @default(0)
  type          String
  referenceId   String?
  reason        String?
  createdAt     DateTime  @default(now())

  @@index([skuId])
  @@index([referenceId])
  @@map("inventory_ledger")
}

model Order {
  id               String      @id @default(uuid(7))
  buyerId          String
  buyer            User        @relation(fields: [buyerId], references: [id])
  totalAmount      BigInt
  paymentStatus    String      @default("PENDING")
  gatewayOrderId   String      @unique
  gatewayPaymentId String?
  reservationCode  String?
  shippingAddress  Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  subOrders        SubOrder[]

  @@map("orders")
}

model SubOrder {
  id               String             @id @default(uuid(7))
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User               @relation(fields: [sellerId], references: [id])
  amount           BigInt
  status           String             @default("PENDING")
  deliveredAt      DateTime?
  settlementStatus String             @default("PENDING")
  shipmentId       String?            @unique
  awbCode          String?            @unique
  courierName      String?
  shipmentStatus   String             @default("PENDING_SYNC")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  items            OrderItem[]
  payout           Payout?
  commissionLogs   CommissionLedger[]

  @@map("sub_orders")
}

model OrderItem {
  id         String   @id @default(uuid(7))
  subOrderId String
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  skuId      String
  sku        Sku      @relation(fields: [skuId], references: [id])
  quantity   Int
  price      BigInt
  mrp        BigInt

  @@map("order_items")
}

model PaymentWebhookLog {
  eventId   String   @id
  processed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("payment_webhook_logs")
}

model CommissionRule {
  id          String   @id @default(uuid(7))
  categoryId  String?  @unique
  sellerId    String?  @unique
  ratePercent Float    // e.g. 5.0 for 5%
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("commission_rules")
}

model CommissionLedger {
  id            String   @id @default(uuid(7))
  subOrderId    String
  amount        BigInt   // Commission amount in paise
  feeRate       Float    // Percentage rate applied at settlement
  type          String   // "EARNED", "REFUNDED"
  createdAt     DateTime @default(now())

  subOrder      SubOrder @relation(fields: [subOrderId], references: [id])

  @@map("commission_ledger")
}

model SellerLinkedAccount {
  id                String   @id @default(uuid(7))
  sellerId          String   @unique
  gatewayAccountId  String   // Razorpay Route account ID (acc_xxx)
  status            String   // "ACTIVE", "SUSPENDED"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [sellerId], references: [id])

  @@map("seller_linked_accounts")
}

model Payout {
  id                String    @id @default(uuid(7))
  sellerId          String
  subOrderId        String    @unique
  amount            BigInt    // Net payout to seller
  gatewayTransferId String?   // Razorpay transfer transaction ID
  status            String    // "PENDING", "SUCCESS", "FAILED", "BLOCKED", "FAILED_PERMANENT"
  idempotencyKey    String    @unique
  retryCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subOrder          SubOrder  @relation(fields: [subOrderId], references: [id])
  seller            User      @relation(fields: [sellerId], references: [id])

  @@map("payouts")
}

model ShipmentWebhookLog {
  id        String   @id @default(uuid(7))
  awbCode   String
  status    String
  createdAt DateTime @default(now())

  @@unique([awbCode, status])
  @@map("shipment_webhook_logs")
}

