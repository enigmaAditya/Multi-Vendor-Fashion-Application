# Database Settings
DATABASE_URL=postgres://dev:dev@localhost:5432/marketplace_dev
DATABASE_TEST_URL=postgres://dev:dev@localhost:5432/marketplace_test

# Redis Cache and Queue Settings
REDIS_URL=redis://localhost:6379

# Meilisearch Settings
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key

# MinIO Object Storage Settings
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dev
MINIO_SECRET_KEY=devdevdev
MINIO_BUCKET=media

# Mailpit SMTP Settings
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Demo Mode (Strictly parsed boolean 'true'/'false')
# When DEMO_MODE=true, POST /auth/otp/request exposes the generated OTP in response as demoOtp
# for non-admin accounts. Admin accounts are NEVER given demoOtp. Defaults to false.
DEMO_MODE=false
